    "check:security": "node scripts/check-security-boundaries.mjs",
    "check:security:commands": "node scripts/check-security-boundaries.mjs commands",
    "check:security:helper": "node scripts/check-security-boundaries.mjs helper",
    "check:security:privilege": "node scripts/check-security-boundaries.mjs privilege",
    "check:security:webview": "node scripts/check-security-boundaries.mjs webview",
