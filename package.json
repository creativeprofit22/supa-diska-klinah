{
  "name": "supa-diska-klinah",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.22.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build",
    "test": "node --test scripts/perf/perf-guards.test.mjs scripts/native-storage-cancellation.test.mjs scripts/check-native-ci.test.mjs scripts/rule-pack.test.mjs scripts/sign-update-manifest.test.mjs scripts/release-assets.test.mjs scripts/workflow-rules.test.mjs && vitest run --dir src --pool=threads --maxWorkers=1",
    "build:helper": "node scripts/build-privileged-helper.mjs",
    "check": "pnpm check:ports && pnpm check:dependencies && pnpm check:parity && pnpm check:architecture && pnpm check:security && pnpm check:docs && pnpm check:i18n && pnpm check:a11y && pnpm check:perf && pnpm build",
    "check:architecture": "node scripts/check-architecture.mjs && node --test scripts/check-architecture.test.mjs",
    "check:types": "tsc --noEmit",
    "check:ports": "node --test scripts/check-ports.test.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:docs": "node scripts/check-docs.mjs && node --test scripts/release-doc-rules.test.mjs",
    "check:i18n": "node scripts/check-i18n.mjs && node --test scripts/check-i18n.test.mjs",
    "check:a11y": "node scripts/check-contrast.mjs && node --test scripts/check-contrast.test.mjs",
    "check:perf": "node scripts/perf/check-build-config.mjs && node --test scripts/perf/perf-guards.test.mjs",
    "perf:budgets": "node scripts/perf/check-budgets.mjs",
    "check:native-ci": "node scripts/check-native-ci.mjs",
    "test:native-ci": "node --test scripts/check-native-ci.test.mjs",
    "test:e2e": "node scripts/check-native-ci.mjs",
    "check:parity": "node scripts/check-parity.mjs && node --test scripts/check-storage-contract.test.mjs",
    "check:security": "node scripts/check-security-boundaries.mjs",
    "check:security:commands": "node scripts/check-security-boundaries.mjs commands",
    "check:security:helper": "node scripts/check-security-boundaries.mjs helper",
    "check:security:privilege": "node scripts/check-security-boundaries.mjs privilege",
    "check:security:webview": "node scripts/check-security-boundaries.mjs webview",
    "test:native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-native.ps1 -Target",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
