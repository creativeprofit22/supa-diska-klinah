{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Supa Diska Klinah",
  "version": "0.1.0",
  "identifier": "com.supadiskaklinah.app",
  "build": {
    "beforeDevCommand": "pnpm build:helper && pnpm dev",
    "beforeBuildCommand": "pnpm build:helper && pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Supa Diska Klinah",
        "width": 960,
        "height": 640,
        "visible": false,
        "focus": false,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/supa-diska-klinah-privileged-helper"],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
