{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Allows only the local main webview to invoke approved application commands.",
  "local": true,
  "webviews": ["main"],
  "permissions": [
    "allow-preview-cleanup",
    "allow-discover-project-artifacts",
    "allow-create-cleanup-plan",
    "allow-execute-cleanup-plan",
    "allow-execute-permanent-cleanup-plan",
    "allow-undo-cleanup",
    "allow-cleanup-history",
    "allow-get-auto-cleanup-policy",
    "allow-set-auto-cleanup-policy",
    "allow-foundation-status",
    "allow-create-system-restore-point"
  ],
  "platforms": ["windows"]
}
