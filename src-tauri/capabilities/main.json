{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Allows only the local main webview to invoke approved application commands.",
  "local": true,
  "webviews": ["main"],
  "permissions": [
    "allow-preview-cleanup",
    "allow-list-project-roots",
    "allow-add-project-root",
    "allow-set-project-root-paused",
    "allow-remove-project-root",
    "allow-discover-project-artifacts",
    "allow-create-cleanup-plan",
    "allow-execute-cleanup-plan",
    "allow-execute-permanent-cleanup-plan",
    "allow-undo-cleanup",
    "allow-cleanup-history",
    "allow-get-auto-cleanup-policy",
    "allow-set-auto-cleanup-policy",
    "allow-list-build-profiles",
    "allow-register-build-profile",
    "allow-remove-build-profile",
    "allow-start-build-run",
    "allow-get-build-run",
    "allow-get-active-build-run",
    "allow-cancel-build-run",
    "allow-get-artifact-budget-policy",
    "allow-set-artifact-budget-policy",
    "allow-preview-artifact-budgets",
    "allow-foundation-status",
    "allow-create-system-restore-point"
  ],
  "platforms": ["windows"]
}
