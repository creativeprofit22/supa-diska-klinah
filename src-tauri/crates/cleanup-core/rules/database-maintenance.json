{"id":"thunderbird","paths":["roaming/Thunderbird/Profiles/*.default*"],"suffixes":["global-messages-db.sqlite","places.sqlite","cookies.sqlite"],"singleFile":true,"unsupported":"Mail/search and account databases require application-closed SQLite maintenance; never file-delete."}
