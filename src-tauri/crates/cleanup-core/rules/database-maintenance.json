{
"id":"databases", "source":"rules/win32/databases.json", "targets":[
{"id":"chromium-profiles","paths":["local/Google/Chrome/User Data/*","local/Microsoft/Edge/User Data/*","local/BraveSoftware/Brave-Browser/User Data/*","local/Vivaldi/User Data/*","local/Arc/User Data/*","local/Chromium/User Data/*","local/Thorium/User Data/*","local/Supermium/User Data/*","local/imput/Helium/User Data/*","local/Cromite/User Data/*","roaming/Opera Software/Opera Stable","roaming/Opera Software/Opera GX Stable"],"suffixes":["History","Cookies","Network/Cookies","Favicons","Top Sites","Web Data","Shortcuts"],"singleFile":true,"unsupported":"Personal browser SQLite database: upstream VACUUM maintenance is not file deletion. No database, journal, WAL or SHM deletion and no command fallback."},
{"id":"firefox","paths":["roaming/Mozilla/Firefox/Profiles/*.default*","roaming/Mozilla/Firefox/Profiles/*.dev-edition*"],"suffixes":["places.sqlite","cookies.sqlite","favicons.sqlite","formhistory.sqlite","webappsstore.sqlite","content-prefs.sqlite"],"singleFile":true,"unsupported":"Personal Firefox SQLite database: requires browser-closed database maintenance, never file deletion."},
