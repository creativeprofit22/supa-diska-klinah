{
  "id":"system", "source":"rules/win32/system.json",
  "targets":[
    {"id":"user-temp","paths":["local/Temp"]},
    {"id":"system-temp","paths":["windows/Temp"]},
    {"id":"prefetch","paths":["windows/Prefetch"]},
    {"id":"windows-logs","paths":["windows/Logs"]},
    {"id":"setup-logs","paths":["windows/Panther"]},
    {"id":"thumbnail-icon-cache","paths":["local/Microsoft/Windows/Explorer"],"filePatterns":["thumbcache_*.db","iconcache_*.db"],"risk":"Explorer contains non-cache state: only direct thumbnail/icon .db files are permitted; locked files remain untouched."},
    {"id":"font-cache","paths":["windows/ServiceProfiles/LocalService/AppData/Local/FontCache"]},
    {"id":"directx","paths":["local/D3DSCache"]},
    {"id":"internet-cache","paths":["local/Microsoft/Windows/INetCache"]},
    {"id":"windows-update","paths":["windows/SoftwareDistribution/Download"]},
    {"id":"delivery-system","paths":["windows/SoftwareDistribution/DeliveryOptimization"]},
    {"id":"error-reports","paths":["local/Microsoft/Windows/WER"]},
    {"id":"system-error-reports","paths":["programData/Microsoft/Windows/WER"]},
    {"id":"crash-dumps","paths":["local/CrashDumps"]},
    {"id":"minidumps","paths":["windows/Minidump"]},
    {"id":"installer-patches","paths":["windows/Installer/$PatchCache$"],"unsupported":"MSI patch baseline is repair/uninstall rollback data; no servicing or installed-program authority."},
    {"id":"event-logs","paths":["windows/System32/winevt/Logs"]},
    {"id":"defender-history","paths":["programData/Microsoft/Windows Defender/Scans/History"]},
    {"id":"windows-old","paths":["systemDrive/Windows.old"]},
