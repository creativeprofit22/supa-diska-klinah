    {"id":"rdp-cache","paths":["local/Microsoft/Terminal Server Client/Cache"]},
    {"id":"debug-logs","paths":["windows/debug"]},
    {"id":"network-temp","paths":["windows/ServiceProfiles/NetworkService/AppData/Local/Temp"]},
    {"id":"windows-caches","paths":["local/Microsoft/Windows/Caches"]},
    {"id":"defender-support","paths":["programData/Microsoft/Windows Defender/Support"]},
    {"id":"defender-metastore","paths":["programData/Microsoft/Windows Defender/Scans/MetaStore"]},
    {"id":"local-service-temp","paths":["windows/ServiceProfiles/LocalService/AppData/Local/Temp"]},
    {"id":"tracing","paths":["windows/tracing"]},
    {"id":"update-db-logs","paths":["windows/SoftwareDistribution/DataStore/Logs"]},
    {"id":"delivery-user","paths":["local/Microsoft/Windows/DeliveryOptimization"]},
    {"id":"reliability","paths":["programData/Microsoft/RAC/PublishedData"]},
    {"id":"search-logs","paths":["programData/Microsoft/Search/Data/Applications/Windows/GatherLogs"]},
    {"id":"diagnostic-etl","paths":["programData/Microsoft/Diagnosis/ETLLogs"]},
    {"id":"power-reports","paths":["programData/Microsoft/Windows/Power Efficiency Diagnostics"]},
    {"id":"live-kernel","paths":["windows/LiveKernelReports"]},
    {"id":"local-system-temp","paths":["windows/ServiceProfiles/LocalSystem/AppData/Local/Temp"]},
    {"id":"defender-nis","paths":["programData/Microsoft/Windows Defender/Network Inspection System/Support"]},
    {"id":"defender-traces","paths":["programData/Microsoft/Windows Defender/Scans/RtSigs"]},
    {"id":"firewall","paths":["windows/System32/LogFiles/Firewall"]},
    {"id":"winsat","paths":["windows/Performance/WinSAT/DataStore"]},
    {"id":"compatibility","paths":["windows/AppCompat/Programs"]},
    {"id":"update-ux","paths":["programData/Microsoft/Windows/RUXIM"]},
    {"id":"local-certificate","paths":["windows/ServiceProfiles/LocalService/AppData/LocalLow/Microsoft/CryptnetUrlCache"]},
    {"id":"network-certificate","paths":["windows/ServiceProfiles/NetworkService/AppData/LocalLow/Microsoft/CryptnetUrlCache"]},
    {"id":"system-certificate","paths":["windows/System32/config/systemprofile/AppData/LocalLow/Microsoft/CryptnetUrlCache"]},
    {"id":"qwave","paths":["windows/ServiceProfiles/LocalService/AppData/Local/Microsoft/Windows/qWave"]},
    {"id":"peer-networking","paths":["windows/ServiceProfiles/LocalService/AppData/Local/PeerNetworking"]},
    {"id":"wmi","paths":["windows/System32/LogFiles/WMI"]},
    {"id":"http-errors","paths":["windows/System32/LogFiles/HTTPERR"]},
    {"id":"elevated-diagnostics","paths":["local/ElevatedDiagnostics"]},
    {"id":"setup-cleanup","paths":["windows/System32/LogFiles/setupcln"]},
    {"id":"update-orchestrator","paths":["programData/USOShared/Logs"]},
    {"id":"memory-dump","paths":["windows/MEMORY.DMP"],"singleFile":true},
    {"id":"energy-report","paths":["windows/System32/energy-report.html"],"singleFile":true}
  ]
}
