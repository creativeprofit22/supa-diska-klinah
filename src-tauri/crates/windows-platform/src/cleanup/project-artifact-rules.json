    {
      "id": "python-environments", "ruleVersion": 1, "lifecycle": "stable", "risk": "recoverable",
      "provenance": { "source": "Python virtual environment documentation", "verifiedAt": "2026-09-03" },
      "defaultSelected": false,
      "artifact": { "ecosystem": "python", "artifactType": "virtualEnvironment", "confidence": "medium", "recoverability": "rebuildable", "rebuildConsequence": "networkDownloadRequired" },
      "scanner": "projectArtifacts", "roots": [{ "binding": "projectRoot", "suffix": "" }],
