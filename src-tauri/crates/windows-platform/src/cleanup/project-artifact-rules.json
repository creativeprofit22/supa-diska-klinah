      "markers": { "anySuffix": [".uproject"] }, "targets": ["Binaries", "DerivedDataCache", "Intermediate"], "targetType": "directory",
      "rootDepth": 0, "projectDepth": 12, "targetDepth": 0, "excludedNames": [".git"]
    },
    {
      "id": "godot-imports", "ruleVersion": 1, "lifecycle": "stable", "risk": "recoverable",
      "provenance": { "source": "Godot imported files documentation", "verifiedAt": "2026-09-03" },
      "defaultSelected": false,
      "artifact": { "ecosystem": "godot", "artifactType": "importedAssetCache", "confidence": "high", "recoverability": "rebuildable", "rebuildConsequence": "expensiveReimport" },
