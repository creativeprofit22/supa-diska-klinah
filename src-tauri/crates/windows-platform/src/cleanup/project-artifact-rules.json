      "markers": { "all": ["package.json"], "any": ["astro.config.mjs", "astro.config.js", "astro.config.ts"] },
      "targets": [".astro", "dist"], "targetType": "directory", "rootDepth": 0, "projectDepth": 12, "targetDepth": 0, "excludedNames": [".git"]
