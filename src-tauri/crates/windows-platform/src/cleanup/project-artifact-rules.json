      "artifact": { "ecosystem": "python", "artifactType": "buildOutput", "confidence": "medium", "recoverability": "rebuildable", "rebuildConsequence": "localRebuild" },
      "scanner": "projectArtifacts", "roots": [{ "binding": "projectRoot", "suffix": "" }],
