{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "rust-build-output", "ruleVersion": 1, "lifecycle": "stable", "risk": "recoverable",
      "provenance": { "source": "Cargo build cache documentation", "verifiedAt": "2026-09-03" },
      "defaultSelected": false,
      "artifact": { "ecosystem": "rust", "artifactType": "buildOutput", "confidence": "high", "recoverability": "rebuildable", "rebuildConsequence": "toolchainRequired" },
      "scanner": "projectArtifacts", "roots": [{ "binding": "projectRoot", "suffix": "" }],
      "markers": { "all": ["Cargo.toml"] }, "targets": ["target"], "targetType": "directory",
      "rootDepth": 0, "projectDepth": 12, "targetDepth": 0, "excludedNames": [".git"]
    },
    {
      "id": "node-installed-dependencies", "ruleVersion": 1, "lifecycle": "stable", "risk": "recoverable",
      "provenance": { "source": "npm local install documentation", "verifiedAt": "2026-09-03" },
      "defaultSelected": false,
      "artifact": { "ecosystem": "nodeJs", "artifactType": "installedDependencies", "confidence": "high", "recoverability": "rebuildable", "rebuildConsequence": "networkDownloadRequired" },
      "scanner": "projectArtifacts", "roots": [{ "binding": "projectRoot", "suffix": "" }],
      "markers": { "all": ["package.json"] }, "targets": ["node_modules"], "targetType": "directory",
      "rootDepth": 0, "projectDepth": 12, "targetDepth": 0, "excludedNames": [".git"]
    },
    {
      "id": "nextjs-generated", "ruleVersion": 1, "lifecycle": "verified", "risk": "recoverable",
